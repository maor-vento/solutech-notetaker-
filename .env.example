# --- Recall.ai (required) -----------------------------------------------
# Sign up at https://recall.ai — create an API key in the dashboard.
# IMPORTANT: the region must match the region shown in your Recall dashboard.
RECALL_API_KEY=
RECALL_REGION=us-east-1            # us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1

# Transcription provider passed to Recall.
# "meeting_captions" uses the platform's built-in captions (no extra cost).
# Note: on Zoom the host must have closed captions enabled; on Meet it just works.
RECALL_TRANSCRIPT_PROVIDER=meeting_captions

# --- Resend (required for email) ----------------------------------------
# Sign up at https://resend.com — free tier is 100 emails/day.
RESEND_API_KEY=
# Until you verify solutech.ai in Resend, use their test sender:
EMAIL_FROM=Solutech Notetaker <onboarding@resend.dev>
EMAIL_TO=maor@solutech.ai

# --- Server --------------------------------------------------------------
PORT=3999
BOT_NAME=Solutech Notetaker

# --- Team login (Supabase, same project as the time-tracking app) --------
# Defaults are baked in for the Solutech project; override only if it moves.
# The notetaker's URL must be added to Supabase Auth -> URL Configuration ->
# Redirect URLs (e.g. http://localhost:3999 and the deployed URL).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# AUTH_DISABLED=true            # keyless local hacking only — never in production

# --- Time-tracking intel pipeline (optional but recommended) -------------
# When set, finished transcripts are POSTed to the time-tracking app's
# notetaker-intel function, which extracts work items into the Work AI tab,
# Slack-DMs the owners, and emails the requester. Leave empty to fall back
# to plain transcript emails from this app.
INTEL_WEBHOOK_URL=            # https://<your-netlify-site>/.netlify/functions/notetaker-intel-background
INTEL_SECRET=                 # must match NOTETAKER_SECRET in Netlify env vars

# --- Google Calendar auto-join (optional) --------------------------------
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials with redirect URI
#   http://localhost:3999/oauth2callback
# and enable the Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How many minutes before a meeting's start the bot should join
CALENDAR_JOIN_OFFSET_MIN=1
